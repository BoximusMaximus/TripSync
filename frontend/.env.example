# Copy this file to .env.local (already gitignored by the root .gitignore)
# and fill in real values. Never commit an actual key.

# Google Cloud Console -> APIs & Services -> Credentials
# Enable "Maps JavaScript API" (+ "Places API" for place_id lookups) on the
# same project, then restrict this key by HTTP referrer to your dev origin
# (http://localhost:5173) and your deployed domain.
VITE_GOOGLE_MAPS_API_KEY=
